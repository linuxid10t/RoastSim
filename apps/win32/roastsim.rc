#include <windows.h>
#include "resource.h"

// Application manifest: visual styles (common controls v6) and DPI awareness.
1 24 "roastsim.manifest"

// Unit labels that need non-ASCII glyphs (degree sign, ohm) are set at run time.
IDD_ENVIRONMENT DIALOGEX 0, 0, 262, 192
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Environment"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Conditions around the roaster. They take effect when you click OK; a roast in progress feels them right away.",
                    -1, 10, 8, 242, 18
    LTEXT           "Room temperature", -1, 10, 34, 96, 8
    EDITTEXT        IDC_ENV_AMBIENT, 110, 32, 54, 13, ES_AUTOHSCROLL
    LTEXT           "C", IDC_ENV_AMBIENT_U, 168, 34, 84, 8
    LTEXT           "Mains voltage", -1, 10, 54, 96, 8
    EDITTEXT        IDC_ENV_VOLTS, 110, 52, 54, 13, ES_AUTOHSCROLL
    LTEXT           "V at the wall, no load", -1, 168, 54, 84, 8
    LTEXT           "Wiring resistance", -1, 10, 74, 96, 8
    EDITTEXT        IDC_ENV_OHMS, 110, 72, 54, 13, ES_AUTOHSCROLL
    LTEXT           "ohms (voltage sag)", IDC_ENV_OHMS_U, 168, 74, 84, 8
    LTEXT           "Gas supply pressure", -1, 10, 94, 96, 8
    EDITTEXT        IDC_ENV_GAS, 110, 92, 54, 13, ES_AUTOHSCROLL
    LTEXT           "% of nominal", -1, 168, 94, 84, 8
    LTEXT           "Altitude", -1, 10, 114, 96, 8
    EDITTEXT        IDC_ENV_ALT, 110, 112, 54, 13, ES_AUTOHSCROLL
    LTEXT           "m", IDC_ENV_ALT_U, 168, 114, 84, 8
    LTEXT           "Relative humidity", -1, 10, 134, 96, 8
    EDITTEXT        IDC_ENV_HUMIDITY, 110, 132, 54, 13, ES_AUTOHSCROLL
    LTEXT           "% RH", -1, 168, 134, 84, 8
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 10, 156, 242, 1
    PUSHBUTTON      "Defaults", IDC_ENV_DEFAULTS, 10, 168, 56, 15
    DEFPUSHBUTTON   "OK", IDOK, 136, 168, 56, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 168, 56, 15
END

IDD_PREHEAT DIALOGEX 0, 0, 220, 88
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preheat"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Brings the empty, powered-on roaster up to temperature with the current control settings, skipping ahead in time.",
                    -1, 10, 8, 200, 26
    LTEXT           "Target", -1, 10, 42, 40, 8
    EDITTEXT        IDC_PRE_TARGET, 54, 40, 50, 13, ES_AUTOHSCROLL
    LTEXT           "C", IDC_PRE_UNIT, 108, 42, 40, 8
    DEFPUSHBUTTON   "Preheat", IDOK, 94, 66, 56, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 154, 66, 56, 15
END

IDD_PRESET DIALOGEX 0, 0, 356, 227
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preset"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT         "", IDC_PRESET_HELP, 10, 8, 336, 21
    LTEXT         "", IDC_PRESET_SECTION, 10, 33, 176, 12
    COMBOBOX      IDC_PRESET_CHOICES, 188, 31, 158, 96, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT         "", IDC_PRESET_DETAIL, 10, 54, 336, 25
    LTEXT         "Air pattern", IDC_PRESET_START_PATTERN_LABEL, 10, 84, 174, 14
    LTEXT         "", IDC_PRESET_START_PATTERN_DETAIL, 10, 105, 336, 25
    LTEXT         "", IDC_PRESET_LABEL0, 10, 54, 174, 14
    EDITTEXT      IDC_PRESET_FIELD0, 188, 51, 158, 14, ES_AUTOHSCROLL
    COMBOBOX      IDC_PRESET_VALUE_CHOICE, 188, 51, 158, 84, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT         "", IDC_PRESET_LABEL0+1, 10, 72, 174, 14
    EDITTEXT      IDC_PRESET_FIELD0+1, 188, 69, 158, 14, ES_AUTOHSCROLL
    LTEXT         "", IDC_PRESET_LABEL0+2, 10, 90, 174, 14
    EDITTEXT      IDC_PRESET_FIELD0+2, 188, 87, 158, 14, ES_AUTOHSCROLL
    LTEXT         "", IDC_PRESET_LABEL0+3, 10, 108, 174, 14
    EDITTEXT      IDC_PRESET_FIELD0+3, 188, 105, 158, 14, ES_AUTOHSCROLL
    LTEXT         "", IDC_PRESET_LABEL0+4, 10, 126, 174, 14
    EDITTEXT      IDC_PRESET_FIELD0+4, 188, 123, 158, 14, ES_AUTOHSCROLL
    LTEXT         "", IDC_PRESET_LABEL0+5, 10, 144, 174, 14
    EDITTEXT      IDC_PRESET_FIELD0+5, 188, 141, 158, 14, ES_AUTOHSCROLL
    LTEXT         "", IDC_PRESET_LABEL0+6, 10, 162, 174, 14
    EDITTEXT      IDC_PRESET_FIELD0+6, 188, 159, 158, 14, ES_AUTOHSCROLL
    LTEXT         "", IDC_PRESET_ERROR, 10, 180, 336, 22
    PUSHBUTTON    "Back", IDC_PRESET_BACK, 10, 204, 56, 15
    PUSHBUTTON    "Cancel", IDCANCEL, 226, 204, 56, 15
    DEFPUSHBUTTON "Next", IDOK, 290, 204, 56, 15
END
