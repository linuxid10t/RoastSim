#include <windows.h>
#include "resource.h"

// Application manifest: visual styles (common controls v6) and DPI awareness.
1 24 "roastsim.manifest"

// Unit labels that need non-ASCII glyphs (degree sign, ohm) are set at run time.
IDD_ENVIRONMENT DIALOGEX 0, 0, 262, 172
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Environment"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Conditions around the roaster. They take effect when you click OK; a roast in progress feels them right away.",
                    -1, 10, 8, 242, 18
    LTEXT           "Room temperature", -1, 10, 34, 96, 8
    EDITTEXT        IDC_ENV_AMBIENT, 110, 32, 54, 13, ES_AUTOHSCROLL
    LTEXT           "C", IDC_ENV_AMBIENT_U, 168, 34, 84, 8
    LTEXT           "Mains voltage", -1, 10, 54, 96, 8
    EDITTEXT        IDC_ENV_VOLTS, 110, 52, 54, 13, ES_AUTOHSCROLL
    LTEXT           "V at the wall, no load", -1, 168, 54, 84, 8
    LTEXT           "Wiring resistance", -1, 10, 74, 96, 8
    EDITTEXT        IDC_ENV_OHMS, 110, 72, 54, 13, ES_AUTOHSCROLL
    LTEXT           "ohms (voltage sag)", IDC_ENV_OHMS_U, 168, 74, 84, 8
    LTEXT           "Gas supply pressure", -1, 10, 94, 96, 8
    EDITTEXT        IDC_ENV_GAS, 110, 92, 54, 13, ES_AUTOHSCROLL
    LTEXT           "% of nominal", -1, 168, 94, 84, 8
    LTEXT           "Altitude", -1, 10, 114, 96, 8
    EDITTEXT        IDC_ENV_ALT, 110, 112, 54, 13, ES_AUTOHSCROLL
    LTEXT           "m", IDC_ENV_ALT_U, 168, 114, 84, 8
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 10, 136, 242, 1
    PUSHBUTTON      "Defaults", IDC_ENV_DEFAULTS, 10, 148, 56, 15
    DEFPUSHBUTTON   "OK", IDOK, 136, 148, 56, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 148, 56, 15
END

IDD_PREHEAT DIALOGEX 0, 0, 220, 88
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preheat"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Brings the empty, powered-on roaster up to temperature with the current control settings, skipping ahead in time.",
                    -1, 10, 8, 200, 26
    LTEXT           "Target", -1, 10, 42, 40, 8
    EDITTEXT        IDC_PRE_TARGET, 54, 40, 50, 13, ES_AUTOHSCROLL
    LTEXT           "C", IDC_PRE_UNIT, 108, 42, 40, 8
    DEFPUSHBUTTON   "Preheat", IDOK, 94, 66, 56, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 154, 66, 56, 15
END
